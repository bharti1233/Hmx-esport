<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Dark counterpart of values/themes.xml. Without this file the platform
      window and the splash screen painted @color/hmx_white before Compose
      produced its first frame, which is the white flash visible when the app
      starts in dark mode.
    -->
    <style name="Theme.HMXArena" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hmx_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.HMXArena.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hmx_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_hmx_mark</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.HMXArena</item>
    </style>

    <style name="Theme.HMXArena.Splash.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hmx_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_hmx_mark</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.HMXArena</item>
    </style>
</resources>
